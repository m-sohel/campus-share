# CampusShare Environment Variables
# Copy this file to .env.local and populate with your Supabase credentials

# Supabase API URL and Public Anon Key (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (Used strictly for server-side seed and admin tasks - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

